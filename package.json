{
  "name": "glean-rag-chatbot",
  "version": "1.0.0",
  "description": "Glean RAG Chatbot - Node.js/TypeScript/React Stack",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "cd client && npm run dev",
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "cd client && npm run build",
    "start": "node dist/server/index.js",
    "index": "tsx server/scripts/indexer.ts",
    "dashboard": "tsx server/scripts/dashboard.ts",
    "mcp": "tsx server/mcp-server.ts",
    "test": "tsx server/scripts/smoke-test.ts",
    "test:all": "./test-all.sh",
    "test:datasources": "tsx server/scripts/test-datasources.ts",
    "test:auth": "tsx server/scripts/test-auth.ts",
    "latency": "./scripts/check-latency.sh",
    "latency:watch": "./scripts/check-latency.sh --watch",
    "latency:stats": "./scripts/check-latency.sh --runs 5 --log",
    "lint": "eslint . --ext .ts,.tsx",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "axios": "^1.7.0",
    "axios-retry": "^4.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.18.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "concurrently": "^8.2.0",
    "eslint": "^8.56.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
