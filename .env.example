# Glean Instance Configuration
GLEAN_INSTANCE=support-lab-be.glean.com
GLEAN_DATASOURCE=interviewds

# Glean API Tokens (three separate tokens required)
# Get these from your Glean sandbox credentials
GLEAN_INDEXING_TOKEN=your_indexing_token_here
GLEAN_CLIENT_TOKEN=your_client_token_here
GLEAN_SEARCH_TOKEN=your_search_token_here

# Optional Configuration
LOG_LEVEL=INFO
DEFAULT_MAX_SOURCES=5
HTTP_TIMEOUT_S=30
RETRY_MAX_ATTEMPTS=3

# Server Configuration (Node.js only)
PORT=3001
CORS_ORIGINS=http://localhost:5173
